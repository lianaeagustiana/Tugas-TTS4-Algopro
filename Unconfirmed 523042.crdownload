def input_penjualan_manual():
    print("=== INPUT DATA PENJUALAN AGROINDUSTRI ===")

    # Meminta input dari pengguna
    produk = input("Nama Produk Agroindustri (misal: Minyak kelapa, Keripik Pisang): ")
    kategori = input("Kategori Produk (misal: Olahan Hasil Tani / Perkebunan): ")
    jumlah_kg = float(input("Jumlah Terjual (kg/satuan): "))
    harga_per_unit = float(input("Harga per Unit (Rp): "))

    # Menghitung total pendapatan
    total_pendapatan = jumlah_kg * harga_per_unit

    # Menampilkan ringkasan
    print("\n--- Ringkasan Data Penjualan ---")
    print(f"Produk           : {produk}")
    print(f"Kategori         : {kategori}")
    print(f"Jumlah           : {jumlah_kg} unit/kg")
    print(f"Harga/Unit       : Rp {harga_per_unit:,.2f}")
    print(f"Total Pendapatan : Rp {total_pendapatan:,.2f}")

input_penjualan_manual()
